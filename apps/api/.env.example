# Copy to apps/api/.env for local development (`npm run dev`).
# In Docker, these are set by compose.yaml instead.

PORT=3000
# Matches the defaults of the `db` service in compose.yaml.
DATABASE_URL=postgresql://mi:mi@localhost:5432/meeting_intelligence

# Embeddings. Ollama from `npm run deps:up` or a native install.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Answers. ollama (local, default model qwen2.5:3b) or anthropic (Claude).
LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_EFFORT=medium
