{
  "name": "meeting-intelligence",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @mi/api",
    "dev:web": "npm run dev -w @mi/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:int": "npm run test:int -w @mi/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @mi/api",
    "db:studio": "npm run db:studio -w @mi/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
