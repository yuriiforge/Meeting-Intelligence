# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Public hostname pointing at the VM's IP (e.g. a free DuckDNS subdomain).
DOMAIN=your-name.duckdns.org

# Everyone you share the link with uses this login.
BASIC_AUTH_USER=demo
BASIC_AUTH_PASSWORD=

# Set before the first start; changing it later doesn't change the existing
# database. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Answers. "ollama" runs qwen2.5:3b on the VM (free, ~1 min per answer on 2
# cores). "anthropic" uses Claude (fast and better, about $0.02 per question).
LLM_PROVIDER=ollama
LLM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_EFFORT=medium
