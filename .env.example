# Copy to .env to override defaults. Every value is optional.

# Postgres (used by docker compose and, later, the api)
POSTGRES_USER=mi
POSTGRES_PASSWORD=mi
POSTGRES_DB=meeting_intelligence
DB_PORT=5432

# Ollama (embeddings). Host port, and the model the api uses.
OLLAMA_PORT=11434
EMBEDDING_MODEL=nomic-embed-text

# Host port for the web app when running the full stack in Docker
WEB_PORT=8080
